{
  "name": "@quickstackdev/sdk",
  "version": "0.0.1",
  "description": "Official SDK for the QuickStack API.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/biersoeckli/QuickStack-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/biersoeckli/QuickStack-sdk/issues"
  },
  "homepage": "https://github.com/biersoeckli/QuickStack-sdk#readme",
  "keywords": [
    "quickstack",
    "quickstack api",
    "sdk",
    "api-client",
    "typescript",
    "javascript"
  ],
  "engines": {
    "node": ">=18"
  },
  "author": {
    "name": "biersoeckli",
    "url": "https://github.com/biersoeckli"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "generate": "rm -f src/generated/Api.ts src/generated/data-contracts.ts src/generated/http-client.ts && bunx swagger-typescript-api generate -p quickstack.openapi.json -o src/generated -n quickstack.ts --modular --extract-request-body --extract-request-params --extract-response-body --extract-response-error",
    "clean": "rm -rf dist",
    "build:js": "bun build ./src/index.ts --outfile ./dist/index.js --target node --format esm",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "bun run clean && bun run build:js && bun run build:types",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
